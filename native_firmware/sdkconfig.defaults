# Baseline config for the Billboard Badge (ESP32-S3, 8MB flash, 8MB octal PSRAM).
# Checked in so CI and every dev get the same starting point; the generated
# `sdkconfig` is gitignored.

CONFIG_IDF_TARGET="esp32s3"

# Flash: 8 MB, quad.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: 8 MB embedded octal SPIRAM (matches the badge module).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Custom partition table (mirrors the stock badge layout; see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Native USB-Serial/JTAG is the only console path on this badge (back-pad UART
# conflicts with the e-paper per board.py).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Give the e-paper refresh / future LLM work generous main-task headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
